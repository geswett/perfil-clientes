# Copia este archivo a .env para correr localmente (no se sube a git).
# En Render, estas mismas variables se configuran en Settings > Environment.

ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# Opcional: modelos a usar (por defecto claude-sonnet-5 en ambos casos)
CLAUDE_MODEL_TEXT=claude-sonnet-5
CLAUDE_MODEL_VISION=claude-sonnet-5

# Opcional: modelo de respaldo si el principal está saturado (error 529) o sin cupo (429)
CLAUDE_MODEL_TEXT_FALLBACK=claude-haiku-4-5-20251001
CLAUDE_MODEL_VISION_FALLBACK=claude-haiku-4-5-20251001
